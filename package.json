{
  "name": "ai-resume-analyzer",
  "version": "1.0.0",
  "description": "AI-Powered Resume Analyzer - Full-Stack SaaS Application",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^2.4.5",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.0"
  },
  "keywords": [
    "resume",
    "analyzer",
    "ats",
    "ai",
    "react",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
